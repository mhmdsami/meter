{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "dashboard/src/**",
      "dashboard/scripts/**",
      "dashboard/*.ts",
      "dashboard/*.mjs",
      "dashboard/*.json",
      "scripts/**",
      "*.json",
      "!dashboard/.next",
      "!dashboard/.open-next",
      "!dashboard/.wrangler",
      "!dashboard/node_modules",
      "!dashboard/package-lock.json",
      "!dashboard/tsconfig.json",
      "!dashboard/next-env.d.ts",
      "!dashboard/src/app/globals.css",
      "!dashboard/src/**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": {
        "noImgElement": "off"
      },
      "a11y": {
        "noLabelWithoutControl": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "javascript": {
    "globals": ["process", "console", "Buffer", "fetch", "AbortSignal", "URL", "TextEncoder"],
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
